# Reference list of every setting. The app reads the process environment; the
# npm scripts also load ./.env when present (never this file). Set these in
# Railway's Variables tab, export them, or copy to .env. NEVER commit a
# filled-in copy.

# --- server -------------------------------------------------------------
# Railway injects PORT. Locally scripts/run_local.sh defaults to 8811 on 127.0.0.1.
PORT=8811
HOST=0.0.0.0

# --- database -----------------------------------------------------------
# On Railway this MUST point inside a mounted Volume, e.g. /data/pegasus.db.
# The plain Railway filesystem is ephemeral: every redeploy wipes it.
DB_PATH=./data/pegasus.db
LOCAL_UPLOAD_DIR=./data/uploads

# --- auth (shared passcodes, not per-user accounts) ---------------------
# STARTUP GUARD: if any of these three is left at the value published in
# src/config.js ("pegasus" / "admin" / "dev-insecure-secret-change-me") the app
# REFUSES to start and names the offending variable.
TEAM_PASSCODE=change-me-team
ADMIN_PASSWORD=change-me-admin
SESSION_SECRET=generate-with-node-crypto-randomBytes-32
SESSION_MAX_AGE_SECONDS=43200

# Local development ONLY: bypass the guard above and serve with the published
# defaults. Off by default and must NEVER be set in production.
# scripts/run_local.sh sets this for you.
ALLOW_INSECURE_DEFAULTS=0

# Session cookie HTTPS-only. Leave unset: it defaults to 1 (secure), and only
# flips to 0 when ALLOW_INSECURE_DEFAULTS=1, so plain-http localhost works
# while production is secure without anyone remembering to set it.
# COOKIE_SECURE=1

# --- proxy ----------------------------------------------------------------
# Peer addresses whose X-Forwarded-For may be trusted for the audit log.
# Empty = never trust it (any client can forge the header). Use "*" only when
# the platform proxy has a dynamic address AND nothing else can reach the port.
TRUSTED_PROXY_IPS=

# --- team -------------------------------------------------------------------
TEAM_MEMBERS=ติ้ว,นาย,คูการ์,หัวหน้าทีม
# EXPENSE_CATEGORIES=อะไหล่โดรน,อิเล็กทรอนิกส์,วัสดุสิ้นเปลือง,เครื่องมือ,เดินทาง,ค่าสมัคร/ค่าธรรมเนียม,อื่น ๆ

# --- verdict tolerance ------------------------------------------------------
# MATCH when |claimed - extracted| <= max(MATCH_EPSILON_THB, claimed * MATCH_EPSILON_PCT)
MATCH_EPSILON_THB=1.0
MATCH_EPSILON_PCT=0.005

# --- providers (leave blank locally; the app runs on stubs) -----------------
GOOGLE_VISION_API_KEY=
# Raw service-account JSON, or the same JSON base64-encoded. NEVER a file path
# inside the repo.
GDRIVE_SA_JSON=
# Folder id inside a SHARED DRIVE (a service account has no My Drive quota).
GDRIVE_FOLDER_ID=
# OpenRouter vision LLM for amount extraction. Unset = off.
# Vision absent  -> the LLM is the OCR stage (replaces the synthetic stub).
# Vision present -> the LLM runs only when Vision finds no amount.
# `npm start` / `npm run dev` load ./.env automatically (gitignored); on
# Railway set these as real Variables instead.
# Format: sk-or-v1-... Left blank here so copying this file never enables a
# bogus key (that would turn every upload into UNREADABLE via HTTP 401).
OPENROUTER_API_KEY=
# Must be a vision-capable model id from https://openrouter.ai/api/v1/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Replies below this confidence, or above this THB amount, are discarded.
LLM_MIN_CONFIDENCE=0.5
LLM_MAX_AMOUNT_THB=1000000
# Set to 1 in production: startup FAILS instead of silently using stubs.
# The LLM counts as a real OCR provider.
REQUIRE_REAL_PROVIDERS=0
# Set to 0 to skip the QR stage entirely.
ENABLE_QR_STAGE=1

# --- misc -------------------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
LOG_LEVEL=info
