# Reference list of every setting. The app reads the process environment; the
# npm scripts also load ./.env when present (never this file). Set these in
# Railway's Variables tab, export them, or copy to .env. NEVER commit a
# filled-in copy.

# --- server -------------------------------------------------------------
# Railway injects PORT. Locally scripts/run_local.sh defaults to 8811 on 127.0.0.1.
PORT=8811
HOST=0.0.0.0

# --- database -----------------------------------------------------------
# On Railway this MUST point inside a mounted Volume, e.g. /data/pegasus.db.
# The plain Railway filesystem is ephemeral: every redeploy wipes it.
DB_PATH=./data/pegasus.db
# Local evidence lands in verified/, needs-review/ and rejected/ under this dir.
LOCAL_UPLOAD_DIR=./data/uploads

# --- auth (per-member accounts) ------------------------------------------
# Everyone logs in with their own username + password; an admin creates the
# accounts at /admin/members. TEAM_PASSCODE is retired: leave it unset (the app
# warns at startup while it is set).
#
# ADMIN_PASSWORD is read ONLY while the database has no admin account: the
# first start creates username "admin" with this password, which must be
# changed at first login. After that it is ignored.
# STARTUP GUARD: the app REFUSES to start while SESSION_SECRET is at the value
# published in src/config.js, or while ADMIN_PASSWORD is at its published
# default ("admin") and would be used for that bootstrap.
ADMIN_PASSWORD=change-me-admin-first-login
SESSION_SECRET=generate-with-node-crypto-randomBytes-32
SESSION_MAX_AGE_SECONDS=43200

# Optional exact public origin for the CSRF check, e.g. https://pegasus.example
# Unset: a POST's Origin must match the request's own Host header.
PUBLIC_ORIGIN=

# Login protection (production defaults shown).
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=900
LOCKOUT_MAX_SECONDS=86400
SETUP_CODE_TTL_SECONDS=259200
# scrypt cost for passwords and setup codes. Lower ONLY in tests.
# PASSWORD_SCRYPT_N=32768

# Local development ONLY: bypass the guard above and serve with the published
# defaults. Off by default and must NEVER be set in production.
# scripts/run_local.sh sets this for you.
ALLOW_INSECURE_DEFAULTS=0

# Session cookie HTTPS-only (named __Host-pegasus_session). Leave unset: it
# defaults to 1 (secure), and only flips to 0 when ALLOW_INSECURE_DEFAULTS=1,
# so plain-http localhost works while production is secure without anyone
# remembering to set it.
# COOKIE_SECURE=1

# --- proxy ----------------------------------------------------------------
# Peer addresses whose X-Forwarded-For may be trusted for the audit log.
# Empty = never trust it (any client can forge the header). Use "*" only when
# the platform proxy has a dynamic address AND nothing else can reach the port.
# Also gates X-Forwarded-Proto for the CSRF check and the IP used by the login
# rate limit.
TRUSTED_PROXY_IPS=
# Header the trusted proxy sets to the real client IP (Fly: fly-client-ip).
# Read only from a TRUSTED_PROXY_IPS peer. Unset = the RIGHTMOST
# X-Forwarded-For entry (the one the proxy appended; the rest is forgeable).
CLIENT_IP_HEADER=

# --- team -------------------------------------------------------------------
# Members are accounts in the database, created by an admin; there is no roster.
# EXPENSE_CATEGORIES=อะไหล่โดรน,อิเล็กทรอนิกส์,วัสดุสิ้นเปลือง,เครื่องมือ,เดินทาง,ค่าสมัคร/ค่าธรรมเนียม,อื่น ๆ

# --- verdict tolerance ------------------------------------------------------
# MATCH when |claimed - extracted| <= max(MATCH_EPSILON_THB, claimed * MATCH_EPSILON_PCT)
MATCH_EPSILON_THB=1.0
MATCH_EPSILON_PCT=0.005

# --- providers (leave blank locally; the app runs on stubs) -----------------
GOOGLE_VISION_API_KEY=
# Raw service-account JSON, or the same JSON base64-encoded. NEVER a file path
# inside the repo.
GDRIVE_SA_JSON=
# Folder id inside a SHARED DRIVE (a service account has no My Drive quota).
GDRIVE_FOLDER_ID=
# Evidence is routed into three subfolders of GDRIVE_FOLDER_ID by the server's
# verdict: Verified (MATCH, no flag), Needs-Review (everything else) and
# Rejected (admin rejected). Leave these blank and the app finds or creates
# folders with those names on first use. Set them only to reuse existing
# folder ids (the service account must be able to write to them).
GDRIVE_FOLDER_VERIFIED=
GDRIVE_FOLDER_REVIEW=
GDRIVE_FOLDER_REJECTED=
# OpenRouter vision LLM for amount extraction. Unset = off.
# Vision absent  -> the LLM is the OCR stage (replaces the synthetic stub).
# Vision present -> the LLM runs only when Vision finds no amount.
# `npm start` / `npm run dev` load ./.env automatically (gitignored); on
# Railway set these as real Variables instead.
# Format: sk-or-v1-... Left blank here so copying this file never enables a
# bogus key (that would turn every upload into UNREADABLE via HTTP 401).
OPENROUTER_API_KEY=
# Must be a vision-capable model id from https://openrouter.ai/api/v1/models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Replies below this confidence, or above this THB amount, are discarded.
LLM_MIN_CONFIDENCE=0.5
LLM_MAX_AMOUNT_THB=1000000
# Set to 1 in production: startup FAILS instead of silently using stubs.
# The LLM counts as a real OCR provider.
REQUIRE_REAL_PROVIDERS=0
# Set to 0 to skip the QR stage entirely.
ENABLE_QR_STAGE=1

# --- misc -------------------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
LOG_LEVEL=info
